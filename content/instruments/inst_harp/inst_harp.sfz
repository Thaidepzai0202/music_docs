// inst_harp — Harp (VSCO-2 CE Harp, mf)
// VSCO-2 Community Edition by Versilian Studios (Sam Gossner) / Ivy Audio (Simon Dalzell), CC0 1.0; github.com/sgossner/VSCO-2-CE — versilian-studios.com/vsco-community/
// Rút gọn bằng engine/tools/le-import-library (agent 80, render/SampleImport.cpp): chọn phím gốc ≥ 3 nửa cung (zone đầu / cuối phủ tới phím 0 / 127), 1 lớp velocity, cắt đầu, cắt đuôi + fade, mono, FLAC 24-bit, tune đo bằng Yin, volume = cân loudness.
<control> default_path=samples/
<global> loop_mode=no_loop ampeg_attack=0.001 ampeg_release=1.20
