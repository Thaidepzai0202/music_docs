// inst_synth — Tone tổng hợp (hài 1/h như fixture inst_synth), C0–C8
// Tổng hợp bằng code: engine/tools/le-gen-instruments (agent 80, render/SynthInstruments.cpp). Không dùng
// sample bên thứ ba. Zone mỗi 3 nửa cung × 2 lớp velocity (zone đầu / cuối phủ tới phím 0 / 127);
// tune bù tần số nguyên Hz; không cân loudness (mỗi sample đỉnh −1 dBFS).
<control> default_path=samples/
<global> loop_mode=loop_continuous ampeg_attack=0.005 ampeg_release=0.3
<region> lokey=0 hikey=14 pitch_keycenter=13 lovel=1 hivel=95 sample=synth_013_soft.flac tune=32.68 volume=0.0 loop_start=12000 loop_end=59999
<region> lokey=0 hikey=14 pitch_keycenter=13 lovel=96 hivel=127 sample=synth_013_hard.flac tune=32.68 volume=0.0 loop_start=12000 loop_end=59999
