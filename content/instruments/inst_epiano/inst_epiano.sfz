// inst_epiano — E-Piano kiểu Rhodes (FM 2 operator + tremolo nhẹ), E1–E7
// Tổng hợp bằng code: engine/tools/le-gen-instruments (agent 80, render/SynthInstruments.cpp). Không dùng
// sample bên thứ ba. Zone mỗi 3 nửa cung × 2 lớp velocity (zone đầu / cuối phủ tới phím 0 / 127);
// tune bù tần số nguyên Hz; volume = cân loudness.
<control> default_path=samples/
<global> loop_mode=loop_continuous ampeg_attack=0.001 ampeg_sustain=0 ampeg_release=0.3
<region> lokey=0 hikey=30 pitch_keycenter=29 lovel=1 hivel=95 sample=ep_029_soft.flac tune=-13.69 volume=0.0 loop_start=62400 loop_end=110399 ampeg_decay=9.0
