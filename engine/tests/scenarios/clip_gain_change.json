      "file": "fixtures/clip_sine_4beats_120.wav",
      "startSample": 0,
      "skip": 49200,
      "loop": true,
      "gain": 0.3543928883824194,
      "maxDiffDb": -100,
      "endSample": 96000
    }
  },
  "requires": [
    "audioClips"
  ]
