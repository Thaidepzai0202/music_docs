// inst_organ — Organ drawbar kiểu tonewheel (888000000; lớp mạnh + 4' và percussion), C2–C7
// Tổng hợp bằng code: engine/tools/le-gen-instruments (agent 80, render/SynthInstruments.cpp). Không dùng
// sample bên thứ ba. Zone mỗi 3 nửa cung × 2 lớp velocity (zone đầu / cuối phủ tới phím 0 / 127);
// tune bù tần số nguyên Hz; volume = cân loudness.
<control> default_path=samples/
<global> loop_mode=loop_continuous ampeg_attack=0.003 ampeg_release=0.06
<region> lokey=0 hikey=38 pitch_keycenter=37 lovel=1 hivel=95 sample=organ_037_soft.flac tune=-17.51 volume=-0.9 loop_start=28800 loop_end=76799
<region> lokey=0 hikey=38 pitch_keycenter=37 lovel=96 hivel=127 sample=organ_037_hard.flac tune=-17.51 volume=-0.4 loop_start=28800 loop_end=76799
