{
  "name": "launch_quantized_1bar",
  "description": "P1-15 DoD: launch ở beat 1.3, quantize 1 bar → clip vào ĐÚNG sample 96000 (beat 4). Có tiếng (click 4 beat): firstNonSilentSample = 96000 + stateAt.",
  "sampleRate": 48000,
  "blockSize": 128,
  "bpm": 120,
  "setup": [
    {
      "call": {
        "op": "clip.setAudio",
        "track": 0,
        "slot": 0,
        "clipId": "c_0_0",
        "file": "fixtures/clip_click_4beats_120.wav",
        "lengthBeats": 4,
        "originalBpm": 120,
        "warp": "repitch",
        "gainDb": 0
      }
    },
    {
      "send": {
        "type": "SET_BPM",
        "d0": 120
      }
    },
    {
      "send": {
        "type": "SET_QUANTIZE",
        "i0": "LE_Q_1_BAR"
      }
    }
  ],
  "timeline": [
    {
      "atBeat": 0,
      "send": {
        "type": "TRANSPORT_PLAY"
      }
    },
    {
      "atBeat": 1.3,
      "send": {
        "type": "CLIP_LAUNCH",
        "track": 0,
        "slot": 0
      }
    }
  ],
  "renderBeats": 12,
  "expect": {
    "stateAt": [
      {
        "frame": 31200,
        "track": 0,
        "slot": 0,
        "clipState": "STOPPED"
      },
      {
        "frame": 31201,
        "track": 0,
        "slot": 0,
        "clipState": "QUEUED_PLAY",
        "playingSlot": -1
      },
      {
        "frame": 96000,
        "track": 0,
        "slot": 0,
        "clipState": "QUEUED_PLAY",
        "playingSlot": -1
      },
      {
        "frame": 96001,
        "track": 0,
        "slot": 0,
        "clipState": "PLAYING",
        "playingSlot": 0
      },
      {
        "frame": 288000,
        "track": 0,
        "slot": 0,
        "clipState": "PLAYING",
        "playingSlot": 0
      }
    ],
    "firstNonSilentSample": 96000,
    "onsetSamples": [
      96000,
      120000,
      144000,
      168000,
      192000,
      216000,
      240000,
      264000
    ]
  },
  "requires": [
    "scheduler"
  ]
}
